{
  "name": "@traceport/core",
  "version": "0.0.1",
  "private": true,
  "description": "Shared client, transport and errors for the Traceport TypeScript SDK.",
  "license": "Apache-2.0",
  "author": "Shineport Innovations Private Limited",
  "homepage": "https://github.com/traceport-ai/sdks/tree/main/typescript/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traceport-ai/sdks.git",
    "directory": "typescript/packages/core"
  },
  "bugs": "https://github.com/traceport-ai/sdks/issues",
  "keywords": [
    "traceport",
    "sdk",
    "api",
    "client"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "internal": [
        "./dist/internal.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check:package": "publint && attw --pack .",
    "prepack": "cp ../../../LICENSE LICENSE && npm run build"
  }
}
